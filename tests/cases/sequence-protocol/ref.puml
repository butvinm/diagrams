@startuml protocol-simple
skinparam responseMessageBelowArrow true
skinparam sequenceMessageAlign center
skinparam maxMessageSize 200

actor " " as User
participant "RClient" as ResourceClient
participant "VClient" as VerificationClient
participant "RService" as ResourceService
participant "VAgent" as VerificationAgent
participant "VService" as VerificationService

activate User

== 1. Verification session start ==
User -> ResourceClient ++ : Resource request
ResourceClient -> ResourceService ++ : Resource request
ResourceService -> VerificationAgent ++ : SessionOpen
VerificationAgent -> VerificationService ++ : SessionOpen
VerificationService --> VerificationAgent -- : VerificationSession
VerificationAgent --> ResourceService -- : VerificationSession
ResourceService --> ResourceClient -- : Redirect with sid
ResourceClient --> User -- : Redirect with sid
User -> VerificationClient ++ : Verification request (sid)
VerificationClient -> VerificationAgent ++ : RequestManifest
VerificationAgent -> VerificationService ++ : RequestManifest
VerificationService --> VerificationAgent -- : Manifest
VerificationAgent --> VerificationClient -- : Manifest

== 2. Collaborative key generation ==
VerificationClient -> VerificationAgent ++ : VClientPKShare
VerificationAgent --> VerificationClient -- : VAgentPKShare
VerificationClient -> VerificationAgent ++ : VClientRLKRound1
VerificationAgent --> VerificationClient -- : VAgentRLKRound1
VerificationClient -> VerificationAgent ++ : VClientRLKRound2
VerificationAgent --> VerificationClient -- : Acknowledgement
VerificationClient -> VerificationAgent ++ : VClientGaloisShares
VerificationAgent -> VerificationAgent : Hierarchical key derivation
VerificationAgent -> VerificationService ++ : InferEvalKeys
VerificationService -> VerificationService : Hierarchical key derivation
VerificationService --> VerificationAgent -- : Acknowledgement
VerificationAgent --> VerificationClient -- : Acknowledgement

== 3. Image transfer and inference ==
User -> VerificationClient : Image
VerificationClient -> VerificationAgent ++ : EncryptedImage
VerificationAgent -> VerificationService ++ : EncryptedImage
VerificationService -> VerificationService : Inference
VerificationService --> VerificationAgent -- : InferenceResult

== 4. Result decryption with integrity protection ==
VerificationAgent -> VerificationAgent : Result authentication
VerificationAgent --> VerificationClient -- : AuthenticatedResult
VerificationClient -> VerificationAgent ++ : PartialDecryption

== 5. Verification session completion ==
VerificationAgent -> ResourceService ++ : VerdictNotification
ResourceService --> VerificationAgent -- : Acknowledgement
VerificationAgent --> VerificationClient -- : Redirect to resource
VerificationClient --> User -- : Redirect to resource
User -> ResourceClient ++ : Return to resource page
ResourceClient -> ResourceService ++ : Resource request
alt Positive verdict
    ResourceService --> ResourceClient : Resource
    ResourceClient --> User : Display resource
else Negative verdict
    ResourceService --> ResourceClient : Access denied
    ResourceClient --> User : Denial message
end
deactivate ResourceService
deactivate ResourceClient
deactivate User

@enduml
